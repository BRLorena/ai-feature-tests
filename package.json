{
  "name": "ai-feature-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "test:contract": "playwright test --project=contract",
    "test:ui": "playwright test --project=ui",
    "test:evals": "npm run -s test:evals:main; npm run -s test:evals:insights",
    "gate": "tsx evals/gate.ts",
    "typecheck": "tsc -p .",
    "report": "playwright show-report reports/playwright-report",
    "test:evals:main": "playwright test --project=evals --project=adversarial --workers=2",
    "test:evals:insights": "RUN_NAME=insights playwright test --project=insights --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "zod": "^3.25.76"
  }
}
